// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "VSCode Icons (Dark)",
  "telemetry": {
    "metrics": false
  },
  "vim_mode": true,
  "relative_line_numbers": true,
  "format_on_save": "off",
  "base_keymap": "VSCode",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "ui_font_family": "MesloLGL Nerd Font",
  "ui_font_weight": 400,
  "ui_font_fallbacks": ["Zed Plex Mono", "Arial"],
  "buffer_font_family": "MesloLGL Nerd Font",
  "buffer_font_weight": 400,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "editor.document_highlight.read_background": "#00000000",
  "editor.document_highlight.write_background": "#00000000",
  "selection_highlight": false,
  "selection_highlight_debounce": 300,
  "lsp_highlight_debounce": 10000,
  "lsp_highlight": false,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark High Contrast"
  },
  "git": {
    "git_gutter": null,
    "gutter_debounce": null,
    "inline_blame": {
      "enabled": false
    }
  }
}

