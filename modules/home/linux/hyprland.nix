# Hyprland (0.55+ reads ~/.config/hypr/hyprland.lua).
# Keys follow the Omarchy/i3 muscle memory from omarchy/hypr/bindings.lua,
# plus the cross-platform shortcuts from NIX_SETUP.md:
#   $mod+D launcher   $mod+Enter terminal   $mod+B Chromium
#   $mod+E Nautilus   $mod+P virt-manager (the NixOS stand-in for Parallels)
{
  config,
  lib,
  pkgs,
  flakeInputs,
  ...
}:
let
  c = import ../../palette.nix;
  wallpapers = "${flakeInputs.omarchy-catppuccin-dark}/backgrounds";

  # Picks a random wallpaper other than the current one.
  wallpaperNext = pkgs.writeShellScript "wallpaper-next" ''
    current=$(cat "$XDG_RUNTIME_DIR/wallpaper" 2>/dev/null)
    next=$(find ${wallpapers} -type f | grep -vxF "$current" | shuf -n1)
    echo "$next" > "$XDG_RUNTIME_DIR/wallpaper"
    pkill -x swaybg
    exec ${pkgs.swaybg}/bin/swaybg -m fill -i "$next"
  '';

  powerMenu = pkgs.writeShellScript "power-menu" ''
    choice=$(printf "Lock\nSuspend\nLog out\nReboot\nShut down" | rofi -dmenu -i -p Power)
    case "$choice" in
      Lock) hyprlock ;;
      Suspend) systemctl suspend ;;
      "Log out") uwsm stop ;;
      Reboot) systemctl reboot ;;
      "Shut down") systemctl poweroff ;;
    esac
  '';

  clipboardMenu = pkgs.writeShellScript "clipboard-menu" ''
    cliphist list | rofi -dmenu -p Clipboard | cliphist decode | wl-copy
  '';

  kbOptions =
    "compose:caps,shift:both_capslock_cancel"
    + lib.optionalString config.dotfiles.macKeyboard ",altwin:swap_alt_win";
in
{
  xdg.configFile."hypr/hyprland.lua".text = ''
    -- Generated by nix/modules/home/linux/hyprland.nix. Edit that file instead.

    local function run(cmd)
      return hl.dsp.exec_cmd("uwsm app -- " .. cmd)
    end

    local function bind(keys, description, dispatcher, opts)
      opts = opts or {}
      opts.description = description
      if type(dispatcher) == "string" then
        dispatcher = hl.dsp.exec_cmd(dispatcher)
      end
      hl.bind(keys, dispatcher, opts)
    end

    -- ---------------------------------------------------------------
    -- Monitors, environment, input
    -- ---------------------------------------------------------------
    hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

    hl.env("XCURSOR_SIZE", "24")
    hl.env("HYPRCURSOR_SIZE", "24")
    hl.env("TERMINAL", "foot")

    hl.config({
      input = {
        kb_layout = "us",
        -- Caps Lock is Compose; both Shifts together toggle Caps Lock.
        ${lib.optionalString config.dotfiles.macKeyboard "-- altwin:swap_alt_win puts Super on the physical Option key (Mac keyboard)."}
        kb_options = "${kbOptions}",
        follow_mouse = 1,
        repeat_rate = 40,
        repeat_delay = 250,
        numlock_by_default = true,
        touchpad = {
          natural_scroll = false,
          clickfinger_behavior = true,
          scroll_factor = 0.4,
        },
      },

      -- ---------------------------------------------------------------
      -- Look and feel: tight gaps, thin borders (nix/hypr/looknfeel.lua),
      -- Catppuccin Dark border gradient
      -- ---------------------------------------------------------------
      general = {
        gaps_in = 1,
        gaps_out = 2,
        border_size = 1,
        col = {
          active_border = { colors = { "rgba(${c.blue}ee)", "rgba(${c.pink}ee)" }, angle = 25 },
          inactive_border = "rgba(1a1a1a60)",
        },
        resize_on_border = true,
        allow_tearing = false,
        layout = "dwindle",
      },

      decoration = {
        rounding = 4,
        shadow = { enabled = false },
        blur = { enabled = true, size = 6, passes = 3 },
      },

      animations = { enabled = true },

      dwindle = {
        preserve_split = true,
        force_split = 2,
      },

      misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        focus_on_activate = true,
        background_color = "rgb(${c.background})",
      },

      cursor = { hide_on_key_press = true },

      binds = {
        -- i3-style: pressing the current workspace's key goes back to the last one
        workspace_back_and_forth = true,
        allow_workspace_cycles = true,
      },

      ecosystem = { no_update_news = true },
    })

    hl.curve("easeOutQuint", { type = "bezier", points = { { 0.23, 1 }, { 0.32, 1 } } })
    hl.curve("water", { type = "bezier", points = { { 0.22, 0.9 }, { 0.36, 1.0 } } })
    hl.animation({ leaf = "global", enabled = true, speed = 10, bezier = "default" })
    hl.animation({ leaf = "windows", enabled = true, speed = 3.0, bezier = "water" })
    hl.animation({ leaf = "windowsIn", enabled = true, speed = 3.0, bezier = "easeOutQuint", style = "popin 87%" })
    hl.animation({ leaf = "fade", enabled = true, speed = 2.4, bezier = "water" })
    hl.animation({ leaf = "workspaces", enabled = false })

    -- ---------------------------------------------------------------
    -- Window rules
    -- ---------------------------------------------------------------
    hl.window_rule({ match = { class = "^(1[pP]assword)$" }, float = true, no_screen_share = true })
    hl.window_rule({ match = { class = "^(pavucontrol|blueman-manager|nm-connection-editor)$" }, float = true, center = true })
    hl.window_rule({ match = { class = "com.moonlight_stream.Moonlight" }, fullscreen = true, idle_inhibit = "fullscreen" })
    hl.window_rule({ match = { class = "^(steam_app_.*)$" }, idle_inhibit = "fullscreen" })

    -- ---------------------------------------------------------------
    -- Apps
    -- ---------------------------------------------------------------
    bind("SUPER + D", "App launcher", run("rofi -show drun"))
    bind("SUPER + SPACE", "App launcher", run("rofi -show drun"))
    bind("SUPER + RETURN", "Terminal (Foot)", run("foot"))
    bind("SUPER + ALT + RETURN", "Alternate terminal (Kitty)", run("kitty"))
    bind("SUPER + B", "Browser", run("chromium"))
    bind("SUPER + E", "File manager", run("nautilus --new-window"))
    bind("SUPER + P", "Virtual machines", run("virt-manager"))
    bind("SUPER + V", "Clipboard history", "${clipboardMenu}")
    bind("SUPER + ESCAPE", "Power menu", "${powerMenu}")
    bind("SUPER + CTRL + L", "Lock", "hyprlock")
    bind("SUPER + CTRL + SPACE", "Next wallpaper", "${wallpaperNext}")
    bind("SUPER + CTRL + B", "Toggle top bar", "pkill -SIGUSR1 waybar")
    bind("SUPER + SHIFT + C", "Reload Hyprland config", "hyprctl reload")

    -- ---------------------------------------------------------------
    -- Windows
    -- ---------------------------------------------------------------
    bind("SUPER + W", "Close window", hl.dsp.window.close())
    bind("SUPER + SHIFT + Q", "Close window", hl.dsp.window.close())
    bind("SUPER + F", "Full screen", hl.dsp.window.fullscreen({ mode = "fullscreen" }))
    bind("SUPER + ALT + F", "Full width", hl.dsp.window.fullscreen({ mode = "maximized" }))
    bind("SUPER + T", "Toggle floating", hl.dsp.window.float({ action = "toggle" }))
    bind("SUPER + SHIFT + SPACE", "Toggle floating", hl.dsp.window.float({ action = "toggle" }))
    bind("SUPER + CTRL + J", "Toggle split", hl.dsp.layout("togglesplit"))

    local directions = { H = "l", J = "d", K = "u", L = "r", LEFT = "l", DOWN = "d", UP = "u", RIGHT = "r" }
    for key, dir in pairs(directions) do
      bind("SUPER + " .. key, "Focus " .. dir, hl.dsp.focus({ direction = dir }))
      bind("SUPER + SHIFT + " .. key, "Swap window " .. dir, hl.dsp.window.swap({ direction = dir }))
    end

    -- Resize on held modifiers: H/L narrower/wider, J/K taller/shorter
    local resize = { H = { -40, 0 }, J = { 0, 40 }, K = { 0, -40 }, L = { 40, 0 } }
    for key, d in pairs(resize) do
      bind("SUPER + ALT + " .. key, "Resize", hl.dsp.window.resize({ x = d[1], y = d[2], relative = true }), { repeating = true })
    end

    bind("SUPER + mouse:272", "Move window", hl.dsp.window.drag(), { mouse = true })
    bind("SUPER + mouse:273", "Resize window", hl.dsp.window.resize(), { mouse = true })

    -- ---------------------------------------------------------------
    -- Workspaces (by keycode, so they work on any layout)
    -- ---------------------------------------------------------------
    for ws = 1, 10 do
      local key = "code:" .. tostring(ws + 9)
      bind("SUPER + " .. key, "Workspace " .. ws, hl.dsp.focus({ workspace = tostring(ws) }))
      bind("SUPER + SHIFT + " .. key, "Move to workspace " .. ws, hl.dsp.window.move({ workspace = tostring(ws) }))
      bind("SUPER + SHIFT + ALT + " .. key, "Move silently to workspace " .. ws, hl.dsp.window.move({ workspace = tostring(ws), follow = false }))
    end

    bind("SUPER + TAB", "Former workspace", hl.dsp.focus({ workspace = "previous" }))
    bind("SUPER + CTRL + TAB", "Next workspace", hl.dsp.focus({ workspace = "e+1" }))
    bind("SUPER + SHIFT + TAB", "Previous workspace", hl.dsp.focus({ workspace = "e-1" }))
    bind("SUPER + S", "Scratchpad", hl.dsp.workspace.toggle_special("scratchpad"))
    bind("SUPER + ALT + S", "Move to scratchpad", hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }))

    -- ---------------------------------------------------------------
    -- Screenshots, media, brightness
    -- ---------------------------------------------------------------
    bind("PRINT", "Screenshot region", "hyprshot -m region --raw | satty --filename - --output-filename ~/Pictures/screenshot-$(date +%F_%T).png")
    bind("SHIFT + PRINT", "Screenshot window", "hyprshot -m window -o ~/Pictures")
    bind("SUPER + PRINT", "Color picker", "hyprpicker -a")

    local osd = "swayosd-client "
    bind("XF86AudioRaiseVolume", "Volume up", osd .. "--output-volume raise", { locked = true, repeating = true })
    bind("XF86AudioLowerVolume", "Volume down", osd .. "--output-volume lower", { locked = true, repeating = true })
    bind("XF86AudioMute", "Mute", osd .. "--output-volume mute-toggle", { locked = true })
    bind("XF86AudioMicMute", "Mute mic", osd .. "--input-volume mute-toggle", { locked = true })
    bind("XF86MonBrightnessUp", "Brightness up", osd .. "--brightness raise", { locked = true, repeating = true })
    bind("XF86MonBrightnessDown", "Brightness down", osd .. "--brightness lower", { locked = true, repeating = true })
    bind("XF86AudioPlay", "Play/pause", "playerctl play-pause", { locked = true })
    bind("XF86AudioPause", "Play/pause", "playerctl play-pause", { locked = true })
    bind("XF86AudioNext", "Next track", "playerctl next", { locked = true })
    bind("XF86AudioPrev", "Previous track", "playerctl previous", { locked = true })

    -- ---------------------------------------------------------------
    -- Autostart (Waybar, Mako, idle, polkit, clipboard and OSD run as
    -- systemd user services from Home Manager)
    -- ---------------------------------------------------------------
    hl.on("hyprland.start", function()
      hl.exec_cmd("${wallpaperNext}")
      hl.exec_cmd("uwsm app -- nm-applet --indicator")
    end)

    -- Personal overrides that aren't managed by Nix
    pcall(dofile, os.getenv("HOME") .. "/.config/hypr/local.lua")
  '';
}
